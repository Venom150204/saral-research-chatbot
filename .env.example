# Gemini API key for the agent, writer, checker and picture descriptions. Keep the
# real value only in .env or the process environment; never commit it.
GEMINI_API_KEY=

# The default text model for every role.
SARAL_TEXT_MODEL=gemini-3.5-flash-lite
# Optional per-role models; each falls back to SARAL_TEXT_MODEL when unset. The
# writer (also used for edits) needs writing quality, and the verifier should be a
# different model from the writer.
SARAL_WRITER_MODEL=
SARAL_VERIFIER_MODEL=
# The agent's model and the model used when it is unavailable. Defaults:
# gemini-3.5-flash-lite and gemini-3.1-flash-lite.
SARAL_AGENT_MODEL=
SARAL_AGENT_FALLBACK_MODEL=

# Dense retrieval runs locally on CPU. The first use downloads and caches the
# MIT-licensed ONNX model; no embedding text is sent to a provider.
SARAL_EMBEDDING_PROVIDER=local
SARAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
SARAL_EMBEDDING_CACHE_DIR=.cache/fastembed
# Describe pictures in uploaded decks so they become citable evidence: on | off.
SARAL_VISUAL_DESCRIPTIONS=on

# PostgreSQL with pgvector.
SARAL_DATABASE_URL=
# Dedicated disposable database only; enables destructive-capable integration tests.
SARAL_TEST_DATABASE_URL=

# Evaluation judge for RAGAS (eval/run_eval.py). Defaults to gemini-3.5-flash, a
# stronger model than the writer it judges.
SARAL_JUDGE_MODEL=
